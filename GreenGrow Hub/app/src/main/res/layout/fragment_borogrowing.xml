<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".boroFragment.borogrowingFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Add your TextViews here inside the LinearLayout -->
            <WebView
                android:id="@+id/borogrowingvideo"
                android:layout_width="match_parent"
                android:layout_height="250dp"/>

            <TextView
                android:id="@+id/borogrowingdetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/paddy_details_bg"
                android:textColor="@color/black"
                android:lineSpacingExtra="10sp"
                android:textSize="18sp"
                android:padding="27px"
                />

        </LinearLayout>
    </ScrollView>
</FrameLayout>